# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Or legacy anon key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Jonny AI assistant — Claude (consigliato)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Optional — default: claude-haiku-4-5 (veloce). Per risposte più articolate: claude-sonnet-4-5
# JONNY_MODEL=claude-haiku-4-5
# Optional — forza provider se hai entrambe le chiavi: anthropic | openai
# JONNY_PROVIDER=anthropic

# Alternativa OpenAI (usata solo se manca ANTHROPIC_API_KEY)
# OPENAI_API_KEY=sk-your-openai-key
# JONNY_MODEL=gpt-4o-mini
